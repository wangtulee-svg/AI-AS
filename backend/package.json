{
  "name": "backend",
  "version": "1.0.0",
  "description": "AI University Student Assistant - Backend API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "fast": "nodemon src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "prisma:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest src/__tests__/services",
    "test:api": "jest src/__tests__/api",
    "test:integration": "jest src/__tests__/integration",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.js'",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "build": "echo 'No build step required'",
    "clean": "rm -rf node_modules package-lock.json",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "ai",
    "university",
    "student",
    "assistant",
    "chatbot",
    "rag",
    "quiz",
    "study-planner"
  ],
  "author": "Lee",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@langchain/core": "^1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "fs-extra": "^11.4.0",
    "helmet": "^8.3.0",
    "hnswlib-node": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.5",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "pdf-parse": "^1.1.4",
    "prisma": "^5.22.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
